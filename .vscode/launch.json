{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {"name":"Python Debugger: FastAPI","type":"debugpy","request":"launch","module":"uvicorn","args":["main:app","--reload"],"jinja":true},{
            "name": "Django: Run and open browser",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "cwd": "${workspaceFolder}",
            "windows": {
                "python": "${workspaceFolder}/.venv/Scripts/python.exe"
            },
            "args": ["runserver", "127.0.0.1:8000", "--noreload"],
            "django": true,
            "console": "internalConsole",
            "env": {
                "PYTHONUNBUFFERED": "1"
            },
            "serverReadyAction": {
                "pattern": "Starting development server at (http://127\\.0\\.0\\.1:8000/)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        },
        {
            "name": "Attach to Edge",
            "port": 9222,
            "request": "attach",
            "type": "msedge",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Attach",
            "port": 9229,
            "request": "attach",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node"
        }
    ]
}
